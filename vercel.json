{
  "installCommand": "node scripts/vercel-diagnostic.cjs && cd frontend && npm install",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "^/assets/.*$",
      "dest": "/$0"
    },
    {
      "src": "^/(404|favicon|vite)\\.(html?|svg|ico|png)$",
      "dest": "/$0"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "status": 200,
      "dest": "/index.html"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
